datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum GlucoseContext {
  FASTING
  BEFORE_MEAL
  AFTER_MEAL
  RANDOM
}

enum GlucoseStatus {
  OPTIMAL
  ELEVATED
  HIGH
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  name            String?
  passwordHash    String? // scrypt, see src/passwords.ts. Null only for accounts made by dev-login.
  emailVerifiedAt DateTime?
  tokenVersion    Int             @default(0) // Bumped on password reset to sign out every existing session
  pushToken       String? // Target signature for Expo/FCM push payloads
  createdAt       DateTime        @default(now())
  glucoseLogs     GlucoseLog[]
  symptomLogs     SymptomLog[]
  mealLogs        MealLog[]
  hydrationLogs   HydrationLog[]
  medicationLogs  MedicationLog[]
  ritualLogs      RitualLog[]
  rescueChecks    RescueCheck[]
  scheduledPush   ScheduledPush?
  authTokens      AuthToken[]
  programState    ProgramState?
}

model GlucoseLog {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  valueMgPerDl Int
  measuredAt   DateTime
  context      GlucoseContext
  status       GlucoseStatus
  notes        String?
  symptomLogs  SymptomLog[]
  rescueCheck  RescueCheck?
  createdAt    DateTime       @default(now())

  @@index([userId, measuredAt])
}

model SymptomLog {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  glucoseLogId String?
  glucoseLog   GlucoseLog? @relation(fields: [glucoseLogId], references: [id], onDelete: SetNull)
  loggedAt     DateTime    @default(now())

  continuousBurping Boolean @default(false)
  bloating          Boolean @default(false)
  nausea            Boolean @default(false)
  abdominalPain     Boolean @default(false)
  extremeLethargy   Boolean @default(false)
  shortnessOfBreath Boolean @default(false)

  severityScore Int @default(1)
}

model MealLog {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedAt              DateTime  @default(now())
  dayOfWeek             DayOfWeek
  programDayNumber      Int
  fiberConsumedFirst    Boolean   @default(false)
  proteinConsumedSecond Boolean   @default(false)
  carbsConsumedLast     Boolean   @default(false)
  isCompliant           Boolean   @default(true)
}

model HydrationLog {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl Int      @default(250)
  loggedAt DateTime @default(now())
}

model MedicationLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medName       String
  doseTaken     String
  scheduledTime DateTime
  takenAt       DateTime @default(now())
  isMissed      Boolean  @default(false)
}

model ProgramState {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate        DateTime @default(now())
  currentDayNumber Int      @default(1) // Increments sequentially 1 -> 90
  currentWeekCycle Int      @default(1) // Loops strictly 1 -> 4 for the 3-month rotation
  isActive         Boolean  @default(true)
}

/// One row per user per local calendar day (the client's date, so it follows the user's time zone).
model RitualLog {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String // YYYY-MM-DD
  okraTakenAt  DateTime?
  cinnamonDone Boolean   @default(false)
  greenTeaDone Boolean   @default(false)
  nextMealTime String? // HH:MM
  lastMealTime String? // HH:MM
  updatedAt    DateTime  @updatedAt

  @@unique([userId, date])
}

/// 200+ Rescue Protocol checklist for one spike reading.
model RescueCheck {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  glucoseLogId String     @unique
  glucoseLog   GlucoseLog @relation(fields: [glucoseLogId], references: [id], onDelete: Cascade)
  hydration    Boolean    @default(false)
  walking      Boolean    @default(false)
  posture      Boolean    @default(false)
  updatedAt    DateTime   @updatedAt
}

/// Durable queue for delayed pushes (the 60-minute recalibration reminder). One pending push per user:
/// a newer spike replaces it. Polled by every API instance; rows are claimed with FOR UPDATE SKIP LOCKED.
model ScheduledPush {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sendAt      DateTime
  title       String
  body        String
  attempts    Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())

  @@index([sendAt])
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Single-use emailed link token. Only its SHA-256 is stored, so a database leak cannot be used to take over accounts.
model AuthToken {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, purpose])
}
